# ============================================================
# 傻子文案大师 V0.1 - 环境变量模板
# ============================================================
# 使用方法：复制本文件为 .env，然后在 .env 里填入真实值。
#   cp .env.example .env
#
# 注意：.env 已被 .gitignore 排除，绝对不会提交到 Git。
#       本模板（.env.example）只能有变量名，不允许出现真实 Key。
# ============================================================

# 第三方大模型 API Key（形如 sk-xxxxxxxx）
API_KEY=

# 第三方大模型 Base URL，例如 https://api.example.com/v1
API_URL=

# 模型名称，例如 gpt-4o-mini / agnes-3.0-flash
MODEL_NAME=

# 服务端口（可选，默认 3100）
PORT=3100
